<launch>

  <!--
    GUI is disabled by default for faster RL training.
    Use gui:=true when debugging visually.
  -->
  <arg name="gui" default="false"/>

  <!-- Load the complete custom Gazebo world.
       The world already contains TurtleBot3 and the Stop Sign target. -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">

    <arg
        name="world_name"
        value="$(find first)/src/set_env.world"
    />

    <arg
        name="paused"
        value="false"
    />

    <arg
        name="use_sim_time"
        value="true"
    />

    <arg
        name="gui"
        value="$(arg gui)"
    />

  </include>

</launch>